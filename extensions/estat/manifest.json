{
  "manifest_version": 3,
  "name": "TUNAGU e-Stat Helper",
  "version": "0.1.0",
  "description": "e-Stat の統計データに関連データ表示とまとめてダウンロード導線を追加します。",
  "permissions": ["storage"],
  "host_permissions": ["https://www.e-stat.go.jp/*", "http://localhost:8000/*"],
  "content_scripts": [
    {
      "matches": ["https://www.e-stat.go.jp/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}

